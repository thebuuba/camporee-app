# CLOUDFLARE_ACCOUNT_ID=fbfe781a453c090425c8bfe52d9e96a6
# MUSIC_R2_BUCKET=camporee-app-music
# CLOUDFLARE_API_TOKEN=  # alternatively, use `wrangler login`
